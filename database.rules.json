{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'owner' || newData.val() === 'guest')"
        },
        "profile": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "user_devices": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$deviceId": {
          "permission": {
            ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'guest')"
          }
        }
      }
    },
    "user_alert_logs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "alert_logs": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "incubators": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$deviceId": {
        ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('user_devices').child(auth.uid).child($deviceId).exists()",
        "control": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('user_devices').child(auth.uid).child($deviceId).child('permission').val() === 'owner'"
        },
        "settings": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('user_devices').child(auth.uid).child($deviceId).child('permission').val() === 'owner'",
          "tempMax": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 45"
          },
          "humidityMax": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 90"
          }
        },
        "telemetry": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "alert": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    }
  }
}
